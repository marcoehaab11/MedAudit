@page
@model IndexModel
@using DentalClinic.Domain.Tenancy
@{
    ViewData["Title"] = "Platform Overview";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
    <div>
        <div class="eyebrow text-emerald-600 fw-bold mb-1">
            <i class="bi bi-shield-check me-1"></i> Global Multi-Tenant Control
        </div>
        <h1 class="h2 fw-bold text-slate-900 mb-0">Platform Administration</h1>
        <p class="text-slate-500 mb-0">Manage dental clinic tenants, subscriptions, and system-wide infrastructure.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary d-inline-flex align-items-center gap-2" asp-page="/Admin/Clinics/Create">
            <i class="bi bi-plus-lg"></i> Register Clinic
        </a>
        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" asp-page="/Admin/Clinics/Index">
            <i class="bi bi-building"></i> All Clinics
        </a>
    </div>
</div>

@if (Model.OpenClinicIssues > 0)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span><strong>@Model.OpenClinicIssues</strong> active clinic subscription(s) expired and need attention.</span>
        <a asp-page="/Admin/Operations" class="alert-link">Review issues</a>
    </div>
}

<!-- KPI Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-slate-500 small fw-medium text-uppercase">Total Clinics</span>
                    <h2 class="fw-bold text-slate-900 mb-0 mt-1">@Model.TotalClinics</h2>
                </div>
                <div class="stat-icon-wrapper bg-primary-subtle text-primary">
                    <i class="bi bi-building fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-slate-500 small fw-medium text-uppercase">Active Tenants</span>
                    <h2 class="fw-bold text-emerald-600 mb-0 mt-1">@Model.ActiveClinics</h2>
                </div>
                <div class="stat-icon-wrapper bg-emerald-subtle text-emerald-600">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-slate-500 small fw-medium text-uppercase">Suspended / Inactive</span>
                    <h2 class="fw-bold text-slate-600 mb-0 mt-1">@(Model.SuspendedClinics + Model.InactiveClinics)</h2>
                </div>
                <div class="stat-icon-wrapper bg-slate-100 text-slate-600">
                    <i class="bi bi-pause-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-slate-500 small fw-medium text-uppercase">System Status</span>
                    <h2 class="fw-bold fs-4 mb-0 mt-1 @(Model.SystemStatus == "Healthy" ? "text-emerald-600" : "text-warning")">@Model.SystemStatus</h2>
                    <a asp-page="/Admin/Operations" class="small">View operations and alerts</a>
                </div>
                <div class="stat-icon-wrapper bg-teal-subtle text-teal-600">
                    <i class="bi bi-cpu fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Portals Grid -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card portal-card shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="portal-icon bg-emerald-subtle text-emerald-700">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Dental Clinic App</h6>
                        <p class="text-slate-500 small mb-0">Single-page Angular workspace for doctors, receptionists, and billing.</p>
                    </div>
                </div>
                <a href="@Model.ClinicAppUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-between">
                    <span>Open Clinic App</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card portal-card shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="portal-icon bg-cyan-subtle text-cyan-700">
                        <i class="bi bi-calendar-heart"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Public Patient Booking</h6>
                        <p class="text-slate-500 small mb-0">Public self-service appointment portal and online prescription verification.</p>
                    </div>
                </div>
                <a href="@Model.BookingAppUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-between">
                    <span>Open Booking Portal</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card portal-card shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="portal-icon bg-indigo-subtle text-indigo-700">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Core REST API & Auth</h6>
                        <p class="text-slate-500 small mb-0">Multi-tenant backend services, PostgreSQL isolation, and Redis cache.</p>
                    </div>
                </div>
                <a href="@Model.ApiHealthUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-between">
                    <span>Inspect Health Status</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Clinics Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
        <div>
            <h5 class="fw-bold mb-0 text-slate-900">Recent Clinics</h5>
            <small class="text-slate-500">Recently registered tenants on the platform</small>
        </div>
        <a asp-page="/Admin/Clinics/Index" class="btn btn-sm btn-outline-secondary">
            View All (@Model.TotalClinics)
        </a>
    </div>
    <div class="table-responsive">
        @if (Model.RecentClinics.Items.Count == 0)
        {
            <div class="p-5 text-center">
                <div class="text-slate-400 mb-2"><i class="bi bi-building fs-1"></i></div>
                <h6 class="fw-bold text-slate-700">No clinics registered yet</h6>
                <p class="text-slate-500 small mb-3">Get started by creating your first dental clinic tenant.</p>
                <a class="btn btn-primary btn-sm" asp-page="/Admin/Clinics/Create">Create Clinic</a>
            </div>
        }
        else
        {
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Clinic Name</th>
                        <th>Tenant Slug</th>
                        <th>Status</th>
                        <th>Location</th>
                        <th>Admin Email</th>
                        <th>Registered Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clinic in Model.RecentClinics.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-page="/Admin/Clinics/Details" asp-route-id="@clinic.Id" class="fw-bold text-decoration-none text-slate-900">
                                    @clinic.Name
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark font-monospace border">@clinic.Slug</span>
                            </td>
                            <td>
                                @if (clinic.Status == TenantStatus.Active)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Active
                                    </span>
                                }
                                else if (clinic.Status == TenantStatus.Suspended)
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-circle-fill me-1"></i> Suspended
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-2 py-1">
                                        @clinic.Status
                                    </span>
                                }
                            </td>
                            <td class="text-slate-600">@clinic.City, @clinic.Country</td>
                            <td class="text-slate-600">@(clinic.AdminEmail ?? "Pending")</td>
                            <td class="text-slate-500 small">@clinic.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="/Admin/Clinics/Details" asp-route-id="@clinic.Id" class="btn btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="/Admin/Clinics/Edit" asp-route-id="@clinic.Id" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
