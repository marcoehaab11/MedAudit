@page
@model DentalClinic.PlatformAdmin.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Planora Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #173b2d; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; background: #f3f8f4; }
        .shell { display: grid; grid-template-columns: minmax(340px, 1fr) minmax(430px, .9fr); min-height: 100vh; }
        .story { position: relative; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; padding: clamp(32px, 5vw, 72px); color: #fff; background: radial-gradient(circle at 78% 22%, #178c64 0, transparent 33%), linear-gradient(145deg, #061b14, #0b4933 75%, #0e7550); }
        .story::after { content: ''; position: absolute; width: 480px; height: 480px; border: 1px solid #ffffff24; border-radius: 50%; right: -120px; bottom: -180px; box-shadow: 0 0 0 90px #ffffff0a, 0 0 0 180px #ffffff08; pointer-events: none; }
        .story > * { position: relative; z-index: 1; }
        .brand { display: inline-flex; align-items: center; gap: 12px; font-size: 1.45rem; font-weight: 800; letter-spacing: -.04em; }
        .brand img { width: 43px; height: 43px; border-radius: 12px; object-fit: cover; }
        .story-content { max-width: 570px; }
        .eyebrow { color: #93ecc2; font-size: .75rem; letter-spacing: .18em; font-weight: 800; }
        .story h1 { font-size: clamp(2.8rem, 4.5vw, 5rem); line-height: 1.08; letter-spacing: -.065em; margin: 17px 0 22px; }
        .story h1 span { color: #a4f0b2; }
        .story p { color: #c4ded1; line-height: 1.8; font-size: 1.04rem; max-width: 470px; }
        .story-foot { display: flex; align-items: center; gap: 10px; color: #a6d6bc; font-size: .85rem; }
        .story-foot i { width: 8px; height: 8px; background: #72e2aa; border-radius: 50%; }
        .form-side { display: grid; place-items: center; padding: 36px; }
        .form-card { width: min(100%, 440px); }
        .form-mark { width: 58px; height: 58px; padding: 5px; border-radius: 17px; background: #fff; box-shadow: 0 8px 25px #0b5f3c16; margin-bottom: 30px; }
        .form-mark img { width: 100%; height: 100%; border-radius: 13px; object-fit: cover; }
        .form-card h2 { font-size: 2.15rem; letter-spacing: -.05em; margin: 0 0 7px; }
        .intro { color: #678174; margin: 0 0 34px; line-height: 1.6; }
        label { display: block; color: #294d3b; font-weight: 700; font-size: .86rem; margin: 0 0 8px; }
        .field { margin-bottom: 20px; }
        input { width: 100%; height: 50px; border: 1px solid #cadfd1; border-radius: 11px; background: #fff; color: #143d2a; font: inherit; padding: 0 15px; transition: box-shadow .2s, border-color .2s; }
        input:focus { outline: 0; border-color: #259d6c; box-shadow: 0 0 0 4px #28ad741e; }
        input::placeholder { color: #9aaa9f; }
        .submit { width: 100%; height: 52px; border: 0; border-radius: 11px; color: #fff; background: #08734e; font: 800 .94rem 'Plus Jakarta Sans', sans-serif; cursor: pointer; box-shadow: 0 12px 25px #08734e2b; margin-top: 9px; }
        .submit:hover { background: #075c3f; }
        .error { padding: 13px 15px; color: #a92929; background: #fff0ee; border: 1px solid #ffc8c2; border-radius: 10px; margin: 0 0 22px; }
        .secure-note { text-align: center; color: #83978a; font-size: .78rem; margin-top: 25px; }
        @@media (max-width: 800px) { .shell { grid-template-columns: 1fr; }.story { min-height: 240px; padding: 30px; }.story h1 { font-size: 2rem; }.story p,.story-foot { display: none; }.form-side { padding: 36px 22px; }.form-mark { display: none; } }
    </style>
</head>
<body>
    <main class="shell">
        <section class="story" aria-label="Planora">
            <div class="brand"><img src="/images/planora-logo.jpg" alt="" /> Planora</div>
            <div class="story-content"><span class="eyebrow">PLATFORM ADMINISTRATION</span><h1>A clearer view<br><span>of every clinic.</span></h1><p>Manage clinics, subscriptions and patient booking from one calm, connected workspace.</p></div>
            <div class="story-foot"><i></i> Secure access for platform administrators</div>
        </section>
        <section class="form-side">
            <div class="form-card">
                <div class="form-mark"><img src="/images/planora-logo.jpg" alt="" /></div>
                <h2>Welcome back</h2>
                <p class="intro">Sign in to your Planora admin workspace.</p>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error" role="alert">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <div class="field"><label for="email">Email address</label><input id="email" asp-for="Input.Email" type="email" autocomplete="username" placeholder="name@company.com" required autofocus /></div>
                    <div class="field"><label for="password">Password</label><input id="password" asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Enter your password" required /></div>
                    <button class="submit" type="submit">Sign in to dashboard →</button>
                </form>
                <p class="secure-note">Your clinic and patient data is protected by your account permissions.</p>
            </div>
        </section>
    </main>
</body>
</html>
