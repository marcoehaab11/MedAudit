@page "/admin/clinics/create"
@model DentalClinic.PlatformAdmin.Pages.Admin.Clinics.CreateModel
@{
    ViewData["Title"] = "Register New Clinic";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-slate-500">Overview</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Clinics/Index" class="text-decoration-none text-slate-500">Clinics</a></li>
                <li class="breadcrumb-item active text-slate-800 fw-semibold" aria-current="page">New Clinic</li>
            </ol>
        </nav>
        <h1 class="h2 fw-bold text-slate-900 mb-0">Register New Clinic</h1>
        <p class="text-slate-500 mb-0">Provision an isolated multi-tenant dental clinic workspace and configure the administrator account.</p>
    </div>
    <div>
        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" asp-page="Index">
            <i class="bi bi-arrow-left"></i> Back to Clinics
        </a>
    </div>
</div>

<form method="post" data-loading-form>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

    <div class="row g-4">
        <!-- Left Column: Clinic Identity & Location -->
        <div class="col-12 col-lg-8">
            <!-- 1. Brand & Identity -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-slate-900 d-flex align-items-center gap-2">
                        <i class="bi bi-building text-emerald-600"></i> Clinic Brand & Identity
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <label asp-for="Input.Name" class="form-label fw-semibold text-slate-700">Clinic Name <span class="text-danger">*</span></label>
                            <input asp-for="Input.Name" class="form-control form-control-lg" placeholder="e.g. Pearl Dental Care" id="clinicNameInput" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-5">
                            <label asp-for="Input.Slug" class="form-label fw-semibold text-slate-700">Tenant Slug <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-slate-500">@@</span>
                                <input asp-for="Input.Slug" class="form-control font-monospace" placeholder="pearl-dental" id="clinicSlugInput" />
                            </div>
                            <span asp-validation-for="Input.Slug" class="text-danger small"></span>
                            <div class="form-text small">Used for tenant subdomain isolation (lowercase, hyphens).</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.LogoReference" class="form-label fw-semibold text-slate-700">Logo Image URL (Optional)</label>
                            <input asp-for="Input.LogoReference" class="form-control" placeholder="https://cdn.example.com/logo.png" />
                            <span asp-validation-for="Input.LogoReference" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Contact & Location -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-slate-900 d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt text-emerald-600"></i> Contact & Location
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.Email" class="form-label fw-semibold text-slate-700">Official Clinic Email <span class="text-danger">*</span></label>
                            <input asp-for="Input.Email" class="form-control" placeholder="info@pearldental.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.Phone" class="form-label fw-semibold text-slate-700">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Input.Phone" class="form-control" placeholder="+1 (555) 234-5678" />
                            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Address" class="form-label fw-semibold text-slate-700">Street Address <span class="text-danger">*</span></label>
                            <input asp-for="Input.Address" class="form-control" placeholder="123 Medical Center Blvd, Suite 400" />
                            <span asp-validation-for="Input.Address" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.City" class="form-label fw-semibold text-slate-700">City <span class="text-danger">*</span></label>
                            <input asp-for="Input.City" class="form-control" placeholder="San Francisco" />
                            <span asp-validation-for="Input.City" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.Country" class="form-label fw-semibold text-slate-700">Country <span class="text-danger">*</span></label>
                            <input asp-for="Input.Country" class="form-control" placeholder="United States" />
                            <span asp-validation-for="Input.Country" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.TimeZone" class="form-label fw-semibold text-slate-700">Timezone <span class="text-danger">*</span></label>
                            <input asp-for="Input.TimeZone" class="form-control font-monospace" value="UTC" />
                            <span asp-validation-for="Input.TimeZone" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.Currency" class="form-label fw-semibold text-slate-700">Billing Currency <span class="text-danger">*</span></label>
                            <input asp-for="Input.Currency" class="form-control text-uppercase font-monospace" value="USD" maxlength="3" />
                            <span asp-validation-for="Input.Currency" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Administrator Account & Handover -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom"><h5 class="fw-bold mb-0">Subscription</h5></div>
                <div class="card-body p-4">
                    <label asp-for="Input.SubscriptionMonths" class="form-label fw-semibold">Initial duration in months</label>
                    <input asp-for="Input.SubscriptionMonths" type="number" min="1" max="120" class="form-control" />
                    <span asp-validation-for="Input.SubscriptionMonths" class="text-danger small"></span>
                    <div class="form-text">Starts when the clinic is created. Access ends automatically at the expiry date unless you extend it.</div>
                </div>
            </div>
            <div class="card shadow-sm border-0 mb-4 bg-emerald-subtle border-emerald-subtle">
                <div class="card-header bg-transparent py-3 px-4 border-bottom border-emerald-200">
                    <h5 class="fw-bold mb-0 text-emerald-900 d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill text-emerald-700"></i> Clinic Administrator
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-light border small text-slate-700 mb-3">
                        <i class="bi bi-info-circle-fill text-primary me-1"></i>
                        This account will have <strong>Full Admin Access</strong> to the Clinic Application at <code>http://app.localhost:8080</code>.
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.AdminEmail" class="form-label fw-semibold text-slate-800">Admin Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Input.AdminEmail" class="form-control bg-white" placeholder="doctor@pearldental.com" />
                        <span asp-validation-for="Input.AdminEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.AdminPassword" class="form-label fw-semibold text-slate-800">Initial password for a new account (optional)</label>
                        <div class="input-group">
                            <input asp-for="Input.AdminPassword" class="form-control font-monospace bg-white" type="password" id="adminPasswordInput" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" onclick="generatePassword()" title="Generate Random Password">
                                <i class="bi bi-shuffle"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.AdminPassword" class="text-danger small"></span>
                        <div class="form-text">Existing accounts keep their password and receive an invitation to the new clinic.</div>
                        <div class="form-text small text-slate-600">Leave blank to let a new administrator set a password from the invitation.</div>
                    </div>
                </div>
            </div>

            <!-- Submit Action Card -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 d-grid gap-2">
                    <button class="btn btn-primary btn-lg d-flex align-items-center justify-content-center gap-2" type="submit">
                        <i class="bi bi-check2-circle fs-5"></i>
                        <span class="default-label">Create & Provision Clinic</span>
                        <span class="loading-label d-none">Provisioning...</span>
                    </button>
                    <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const nameInput = document.getElementById('clinicNameInput');
        const slugInput = document.getElementById('clinicSlugInput');

        if (nameInput && slugInput) {
            nameInput.addEventListener('input', function () {
                if (!slugInput.dataset.manual) {
                    slugInput.value = this.value
                        .toLowerCase()
                        .trim()
                        .replace(/[^a-z0-9\s-]/g, '')
                        .replace(/\s+/g, '-');
                }
            });
            slugInput.addEventListener('input', function () {
                this.dataset.manual = 'true';
            });
        }

        function generatePassword() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@@#$%';
            let pass = '';
            const random = new Uint32Array(16);
            crypto.getRandomValues(random);
            for (const value of random) {
                pass += chars.charAt(value % chars.length);
            }
            document.getElementById('adminPasswordInput').value = pass;
        }
    </script>
}
