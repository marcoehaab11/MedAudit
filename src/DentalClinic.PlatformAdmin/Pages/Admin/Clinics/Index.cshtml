@page "/admin/clinics"
@model DentalClinic.PlatformAdmin.Pages.Admin.Clinics.IndexModel
@using DentalClinic.Domain.Tenancy
@{
    ViewData["Title"] = "Clinics Management";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-slate-500">Overview</a></li>
                <li class="breadcrumb-item active text-slate-800 fw-semibold" aria-current="page">Clinics</li>
            </ol>
        </nav>
        <h1 class="h2 fw-bold text-slate-900 mb-0">Clinics Management</h1>
        <p class="text-slate-500 mb-0">Create, review, and control tenant clinic access across the multi-tenant platform.</p>
    </div>
    <div>
        <a class="btn btn-primary d-inline-flex align-items-center gap-2" asp-page="Create">
            <i class="bi bi-plus-lg"></i> Register New Clinic
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2 shadow-sm mb-4" role="status">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@Model.SuccessMessage</div>
    </div>
}

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end" data-loading-form>
            <div class="col-12 col-md-5">
                <label class="form-label small fw-semibold text-slate-600 mb-1" asp-for="Search">Search Tenants</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-slate-400"><i class="bi bi-search"></i></span>
                    <input class="form-control" asp-for="Search" placeholder="Search by clinic name, slug, email, city..." />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-slate-600 mb-1" asp-for="Status">Tenant Status</label>
                <select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<TenantStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-1" type="submit">
                    <i class="bi bi-funnel"></i>
                    <span class="default-label">Filter</span>
                    <span class="loading-label d-none">Loading…</span>
                </button>
                @if (!string.IsNullOrEmpty(Model.Search) || Model.Status.HasValue)
                {
                    <a asp-page="Index" class="btn btn-outline-secondary" title="Clear Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.Clinics.Items.Count == 0)
{
    <div class="card shadow-sm border-0 p-5 text-center">
        <div class="text-slate-300 mb-3"><i class="bi bi-building fs-1"></i></div>
        <h4 class="fw-bold text-slate-800">No clinics found</h4>
        <p class="text-slate-500 mb-4">No clinic records match your search criteria. Try adjusting the filters or register a new clinic.</p>
        <div class="d-inline-flex justify-content-center gap-2">
            <a class="btn btn-primary" asp-page="Create">Register Clinic</a>
            <a class="btn btn-outline-secondary" asp-page="Index">Reset Filters</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Clinic Name</th>
                        <th>Tenant Slug</th>
                        <th>Status</th>
                        <th>Subscription</th>
                        <th>Location</th>
                        <th>Admin Contact</th>
                        <th>Created</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var clinic in Model.Clinics.Items)
                {
                    <tr>
                        <td class="ps-4">
                            <a class="fw-bold text-slate-900 text-decoration-none" asp-page="Details" asp-route-id="@clinic.Id">
                                @clinic.Name
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark font-monospace border">@clinic.Slug</span>
                        </td>
                        <td>
                            @if (clinic.Status == TenantStatus.Active)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-2 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> Active
                                </span>
                            }
                            else if (clinic.Status == TenantStatus.Suspended)
                            {
                                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-2 py-1">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Suspended
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-2 py-1">
                                    @clinic.Status
                                </span>
                            }
                        </td>
                        <td>
                            @if (clinic.SubscriptionExpiresAt <= DateTimeOffset.UtcNow)
                            { <span class="badge bg-danger">Expired</span> }
                            else
                            { <span class="badge bg-success">Until @clinic.SubscriptionExpiresAt.ToString("dd/MM/yyyy")</span> }
                        </td>
                        <td class="text-slate-600">@clinic.City, @clinic.Country</td>
                        <td class="text-slate-600 font-monospace small">@(clinic.AdminEmail ?? "Pending")</td>
                        <td class="text-slate-500 small">@clinic.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@clinic.Id" title="View Details">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@clinic.Id" title="Edit Profile">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Clinics.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2 border-top">
                <span class="text-slate-500 small">Page @Model.Clinics.Page of @Model.Clinics.TotalPages · <strong>@Model.Clinics.TotalCount</strong> clinics total</span>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-secondary @(Model.Clinics.Page <= 1 ? "disabled" : null)" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-PageNumber="@(Model.Clinics.Page - 1)">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                    <a class="btn btn-outline-secondary @(Model.Clinics.Page >= Model.Clinics.TotalPages ? "disabled" : null)" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-PageNumber="@(Model.Clinics.Page + 1)">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}
