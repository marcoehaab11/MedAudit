@page "/admin/clinics/{id:guid}"
@model DentalClinic.PlatformAdmin.Pages.Admin.Clinics.DetailsModel
@using DentalClinic.Domain.Tenancy
@using DentalClinic.Domain.Identity
@{
    ViewData["Title"] = Model.Clinic.Name;
    var adminPassword = TempData["CreatedAdminPassword"] as string;
    var adminEmail = TempData["CreatedAdminEmail"] as string ?? Model.Clinic.AdminEmail;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-slate-500">Overview</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Clinics/Index" class="text-decoration-none text-slate-500">Clinics</a></li>
                <li class="breadcrumb-item active text-slate-800 fw-semibold" aria-current="page">@Model.Clinic.Name</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-3">
            <h1 class="h2 fw-bold text-slate-900 mb-0">@Model.Clinic.Name</h1>
            @if (Model.Clinic.Status == TenantStatus.Active)
            {
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2 fs-6">
                    <i class="bi bi-check-circle-fill me-1"></i> Active
                </span>
            }
            else if (Model.Clinic.Status == TenantStatus.Suspended)
            {
                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-3 py-2 fs-6">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Suspended
                </span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-3 py-2 fs-6">
                    @Model.Clinic.Status
                </span>
            }
        </div>
        <p class="text-slate-500 mb-0 font-monospace">Tenant Slug: @Model.Clinic.Slug</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary d-inline-flex align-items-center gap-2" asp-page="Edit" asp-route-id="@Model.Clinic.Id">
            <i class="bi bi-pencil"></i> Edit Profile
        </a>
        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" asp-page="Index">
            <i class="bi bi-arrow-left"></i> All Clinics
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 px-4"><h2 class="h5 fw-bold mb-0">Clinic activity · last 30 days</h2></div>
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-6 col-lg-2"><div class="p-3 bg-light rounded"><small>New patients</small><div class="h3 mb-0">@Model.Usage.Patients</div></div></div>
            <div class="col-6 col-lg-2"><div class="p-3 bg-light rounded"><small>Appointments</small><div class="h3 mb-0">@Model.Usage.Appointments</div></div></div>
            <div class="col-6 col-lg-2"><div class="p-3 bg-light rounded"><small>Online bookings</small><div class="h3 mb-0">@Model.Usage.OnlineBookings</div></div></div>
            <div class="col-6 col-lg-2"><div class="p-3 bg-light rounded"><small>Booking leads</small><div class="h3 mb-0">@Model.Usage.BookingInquiries</div></div></div>
            <div class="col-6 col-lg-2"><div class="p-3 bg-light rounded"><small>Page visits</small><div class="h3 mb-0">@Model.Usage.PageVisits</div></div></div>
            <div class="col-6 col-lg-2"><div class="p-3 bg-light rounded"><small>Failed messages</small><div class="h3 mb-0 @(Model.Usage.FailedNotifications > 0 ? "text-danger" : "")">@Model.Usage.FailedNotifications</div></div></div>
        </div>
        <div class="mt-3 small text-muted">Uncontacted booking leads over 2 hours: <strong class="@(Model.Usage.UncontactedLeads > 0 ? "text-warning" : "")">@Model.Usage.UncontactedLeads</strong> · Last appointment recorded: @(Model.Usage.LastActivity?.ToString("dd MMM yyyy HH:mm 'UTC'") ?? "None yet")</div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 booking-share-card">
    <div class="card-body p-4 d-flex flex-wrap gap-4 align-items-center justify-content-between">
        <div class="flex-grow-1">
            <span class="text-emerald-600 small fw-bold text-uppercase">Patient registration</span>
            <h2 class="h4 fw-bold mt-1">Public booking page</h2>
            @if (!Model.Clinic.PublicBookingEnabled) { <span class="badge bg-warning text-dark mb-2">Booking paused — clinic owner can enable it in Online Booking</span> }
            <p class="text-muted mb-3">Share this clinic-specific link with patients. The clinic owner can edit the public details and follow up on bookings from the clinic app.</p>
            <div class="input-group" style="max-width: 680px"><input id="clinic-booking-url" class="form-control" value="@Model.BookingUrl" readonly aria-label="Clinic booking link" /><button type="button" class="btn btn-outline-primary" onclick="navigator.clipboard.writeText(document.getElementById('clinic-booking-url').value)">Copy link</button></div>
            <a href="@Model.BookingUrl" target="_blank" rel="noopener" class="btn btn-primary mt-3">Open patient page ↗</a>
        </div>
        <div class="booking-share-qr text-center"><img src="@Model.BookingQrDataUri" alt="QR code for @Model.Clinic.Name online booking" width="170" height="170" /><div><a class="btn btn-sm btn-outline-secondary mt-2" href="@Model.BookingQrDataUri" download="@($"{Model.Clinic.Slug}-booking-qr.svg")">Download QR</a></div></div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom"><h5 class="fw-bold mb-0">Subscription &amp; clinic access</h5></div>
    <div class="card-body p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3"><span class="text-muted small d-block">Started (UTC)</span><strong>@Model.Clinic.SubscriptionStartsAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div class="col-md-3"><span class="text-muted small d-block">Expires (UTC)</span><strong>@Model.Clinic.SubscriptionExpiresAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div class="col-md-3">
                @if (Model.Clinic.SubscriptionExpiresAt <= Model.Now)
                { <span class="badge bg-danger">Expired — all clinic users blocked</span> }
                else if (Model.Clinic.Status != TenantStatus.Active)
                { <span class="badge bg-warning text-dark">Subscription valid; clinic disabled</span> }
                else
                { <span class="badge bg-success">Active — @Math.Ceiling((Model.Clinic.SubscriptionExpiresAt - Model.Now).TotalDays) days left</span> }
            </div>
            <div class="col-md-3">
                <form method="post" asp-page-handler="Extend" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@Model.Clinic.Id" />
                    <input name="months" type="number" min="1" max="120" value="1" required class="form-control" aria-label="Months to add" />
                    <button type="submit" class="btn btn-primary text-nowrap">Add months</button>
                </form>
                @if (ViewData.ModelState.TryGetValue("months", out var monthErrors) && monthErrors.Errors.Count > 0)
                { <span class="text-danger small">@monthErrors.Errors[0].ErrorMessage</span> }
            </div>
        </div>
        <p class="text-muted small mt-3 mb-0">Expiry blocks the owner and every staff account automatically. Suspending the clinic blocks them immediately even when the subscription is valid.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@Model.SuccessMessage</div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.BackupErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.BackupErrorMessage</div>
}

<!-- Administrator Login & Access Handover Card -->
<div class="card shadow-sm border-0 mb-4 bg-emerald-subtle border-emerald-subtle">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
        <div>
            <h5 class="fw-bold mb-0 text-slate-900 d-flex align-items-center gap-2">
                <i class="bi bi-key-fill text-emerald-600"></i> Clinic Access & Login Credentials
            </h5>
            <small class="text-slate-500">Credentials to log into the Dental Clinic Application workspace</small>
        </div>
        <a id="clinic-portal-link" href="@Model.ClinicAppUrl" target="_blank" rel="noopener" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1">
            <span>Open Clinic Portal</span> <i class="bi bi-box-arrow-up-right"></i>
        </a>
    </div>
    <div class="card-body p-4 bg-white">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-4">
                <div class="p-3 bg-slate-50 border rounded-3">
                    <span class="text-slate-500 small text-uppercase fw-semibold d-block">Web Application URL</span>
                    <a href="@Model.ClinicAppUrl" target="_blank" rel="noopener" class="fw-bold font-monospace text-emerald-700 text-decoration-none d-flex align-items-center gap-1 mt-1">
                        @Model.ClinicAppUrl <i class="bi bi-box-arrow-up-right small"></i>
                    </a>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="p-3 bg-slate-50 border rounded-3">
                    <span class="text-slate-500 small text-uppercase fw-semibold d-block">Clinic Admin Email</span>
                    <span class="fw-bold font-monospace text-slate-900 d-block mt-1">@(adminEmail ?? "Pending")</span>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="p-3 bg-slate-50 border rounded-3">
                    <span class="text-slate-500 small text-uppercase fw-semibold d-block">Admin Password</span>
                    @if (!string.IsNullOrEmpty(adminPassword))
                    {
                        <span class="fw-bold font-monospace text-primary d-block mt-1">@adminPassword</span>
                    }
                    else
                    {
                        <span class="text-slate-600 font-monospace d-block mt-1"><em>(Set during clinic creation)</em></span>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top text-muted small">
            <div>
                <i class="bi bi-info-circle me-1"></i> Clinic staff can sign in at <code>@Model.ClinicAppUrl</code> using their email and password.
            </div>
            @if (!string.IsNullOrEmpty(adminPassword))
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="copyCredentials('@adminEmail', '@adminPassword')">
                    <i class="bi bi-clipboard me-1"></i> Copy Login Details
                </button>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Clinic Profile Details -->
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold mb-0 text-slate-900 d-flex align-items-center gap-2">
                    <i class="bi bi-card-heading text-emerald-600"></i> Clinic Information
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-12 col-sm-6">
                        <span class="text-slate-500 small text-uppercase fw-semibold d-block">Official Email</span>
                        <span class="fw-medium text-slate-900">@Model.Clinic.Email</span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-slate-500 small text-uppercase fw-semibold d-block">Phone Number</span>
                        <span class="fw-medium text-slate-900">@Model.Clinic.Phone</span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-slate-500 small text-uppercase fw-semibold d-block">Street Address</span>
                        <span class="fw-medium text-slate-900">@Model.Clinic.Address</span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-slate-500 small text-uppercase fw-semibold d-block">Location</span>
                        <span class="fw-medium text-slate-900">@Model.Clinic.City, @Model.Clinic.Country</span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-slate-500 small text-uppercase fw-semibold d-block">Operating Timezone</span>
                        <span class="badge bg-light text-dark border font-monospace">@Model.Clinic.TimeZone</span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-slate-500 small text-uppercase fw-semibold d-block">Billing Currency</span>
                        <span class="badge bg-light text-dark border font-monospace">@Model.Clinic.Currency</span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-slate-500 small text-uppercase fw-semibold d-block">Registration Date</span>
                        <span class="text-slate-700">@Model.Clinic.CreatedAt.ToString("dd/MM/yyyy HH:mm 'UTC'")</span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-slate-500 small text-uppercase fw-semibold d-block">Last Updated</span>
                        <span class="text-slate-700">@Model.Clinic.UpdatedAt.ToString("dd/MM/yyyy HH:mm 'UTC'")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status & Management Actions -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold mb-0 text-slate-900 d-flex align-items-center gap-2">
                    <i class="bi bi-sliders text-emerald-600"></i> Tenant Status Controls
                </h5>
            </div>
            <div class="card-body p-4">
                <p class="text-slate-600 small mb-3">Control clinic access to the system. Suspended or inactive tenants cannot log in.</p>
                <div class="d-grid gap-2">
                    @if (Model.Clinic.Status != TenantStatus.Active)
                    {
                        <form method="post" asp-page-handler="Status">
                            <input type="hidden" name="id" value="@Model.Clinic.Id" />
                            <input type="hidden" name="status" value="Active" />
                            <button class="btn btn-success w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
                                <i class="bi bi-check-circle"></i> Activate Clinic
                            </button>
                        </form>
                    }
                    @if (Model.Clinic.Status != TenantStatus.Inactive)
                    {
                        <form method="post" asp-page-handler="Status">
                            <input type="hidden" name="id" value="@Model.Clinic.Id" />
                            <input type="hidden" name="status" value="Inactive" />
                            <button class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
                                <i class="bi bi-power"></i> Deactivate Clinic
                            </button>
                        </form>
                    }
                    @if (Model.Clinic.Status != TenantStatus.Suspended)
                    {
                        <form method="post" asp-page-handler="Status">
                            <input type="hidden" name="id" value="@Model.Clinic.Id" />
                            <input type="hidden" name="status" value="Suspended" />
                            <button class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
                                <i class="bi bi-pause-circle"></i> Suspend Tenant
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold mb-0 text-slate-900 d-flex align-items-center gap-2">
                    <i class="bi bi-link-45deg text-emerald-600"></i> Tenant Endpoints
                </h5>
            </div>
            <div class="card-body p-3">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>Clinic Staff App</span>
                        <a href="@Model.ClinicAppUrl" target="_blank" rel="noopener" class="text-decoration-none">Clinic app <i class="bi bi-box-arrow-up-right"></i></a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>Public Booking</span>
                        <a href="@Model.BookingUrl" target="_blank" rel="noopener" class="text-decoration-none">Patient booking <i class="bi bi-box-arrow-up-right"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mt-4 mb-4">
    <div class="card-header bg-white py-3 px-4"><h5 class="fw-bold mb-0">Backup &amp; restore · @Model.Clinic.Name</h5></div>
    <div class="card-body p-4">
        <p class="text-muted">Download an encrypted full copy of this clinic. Keep the file and its password outside the server. Only platform administrators can restore it.</p>
        <form method="post" asp-page-handler="Backup" class="row g-2 align-items-end mb-4">
            <input type="hidden" name="id" value="@Model.Clinic.Id" />
            <div class="col-md-8"><label class="form-label" for="backup-password">Backup password · at least 12 characters</label><input id="backup-password" class="form-control" type="password" name="password" minlength="12" required autocomplete="new-password" /></div>
            <div class="col-md-4"><button class="btn btn-outline-primary w-100" type="submit">Download full backup</button></div>
        </form>
        <form id="restore-form" method="post" enctype="multipart/form-data" asp-page-handler="Restore" data-preview-url="@Url.Page("/Admin/Clinics/Details", "PreviewRestore", new { id = Model.Clinic.Id })" onsubmit="return confirm('Replace this clinic’s selected data with the inspected backup? This action cannot be undone without your downloaded safety copy.');">
            <input type="hidden" name="id" value="@Model.Clinic.Id" />
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label" for="restore-file">Encrypted backup file</label><input id="restore-file" class="form-control" type="file" name="file" accept=".plnbak" required /></div>
                <div class="col-md-6"><label class="form-label" for="restore-password">Backup password</label><input id="restore-password" class="form-control" type="password" name="password" required /></div>
            </div>
            <div id="restore-preview" class="alert alert-secondary my-3" aria-live="polite">Select a backup and preview its clinic, date, modules and row count before restoring.</div>
            <label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="safetyCopyDownloaded" value="true" required /><span class="form-check-label">I downloaded a current full backup of this clinic as a safety copy.</span></label>
            <div class="d-flex gap-2"><button id="preview-restore" class="btn btn-outline-secondary" type="button">Preview restore</button><button id="confirm-restore" class="btn btn-danger" type="submit" disabled>Restore clinic data</button></div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 mt-4 mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom"><h5 class="fw-bold mb-0">Clinic users &amp; individual access</h5></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th class="ps-4">User</th><th>Role</th><th>Status</th><th class="text-end pe-4">Access</th></tr></thead>
            <tbody>
            @foreach (var user in Model.Users.Items)
            {
                <tr>
                    <td class="ps-4"><strong>@user.DisplayName</strong><div class="text-muted small">@user.Email</div></td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td><span class="badge @(user.Status == UserStatus.Active ? "bg-success" : "bg-secondary")">@user.Status</span></td>
                    <td class="text-end pe-4">
                        <form method="post" asp-page-handler="UserAccess" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Clinic.Id" />
                                <input type="hidden" name="userId" value="@user.Id" />
                                <input type="hidden" name="active" value="@(user.Status == UserStatus.Inactive ? "true" : "false")" />
                            <button class="btn btn-sm @(user.Status == UserStatus.Inactive ? "btn-outline-success" : "btn-outline-danger")" type="submit">@(user.Status == UserStatus.Active ? "Disable now" : user.Status == UserStatus.Invited ? "Cancel access" : "Restore access")</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Users.TotalCount > Model.Users.PageSize)
    {
        <div class="card-footer bg-white d-flex justify-content-between">
            @if (Model.Users.Page > 1) { <a asp-route-id="@Model.Clinic.Id" asp-route-userPage="@(Model.Users.Page - 1)">Previous</a> }
            <span>Page @Model.Users.Page</span>
            @if (Model.Users.Page * Model.Users.PageSize < Model.Users.TotalCount) { <a asp-route-id="@Model.Clinic.Id" asp-route-userPage="@(Model.Users.Page + 1)">Next</a> }
        </div>
    }
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('restore-form');
            const preview = document.getElementById('restore-preview');
            const restore = document.getElementById('confirm-restore');
            for (const id of ['restore-file', 'restore-password']) document.getElementById(id).addEventListener('change', () => { restore.disabled = true; preview.textContent = 'Preview this file before restoring.'; });
            document.getElementById('preview-restore').addEventListener('click', async () => {
                restore.disabled = true;
                if (!form.querySelector('[name="file"]').files.length) { preview.textContent = 'Select a backup file first.'; return; }
                preview.textContent = 'Checking backup…';
                try {
                    const response = await fetch(form.dataset.previewUrl, { method: 'POST', body: new FormData(form), credentials: 'same-origin' });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.error || 'Backup could not be inspected.');
                    preview.textContent = `Clinic: ${result.clinicName} · Created: ${new Date(result.createdAt).toLocaleString()} · Modules: ${result.modules.join(', ')} · Tables: ${result.tables} · Rows: ${result.rows}`;
                    restore.disabled = false;
                } catch (error) { preview.textContent = error.message; }
            });
        })();
        function copyCredentials(email, password) {
            const text = `Clinic Portal: ${document.getElementById('clinic-portal-link').href}\nEmail: ${email}\nPassword: ${password}`;
            navigator.clipboard.writeText(text).then(() => {
                alert('Credentials copied to clipboard!');
            });
        }
    </script>
}
