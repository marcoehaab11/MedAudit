<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · MedDentist Platform Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-slate-900 border-bottom border-slate-800 shadow-sm">
            <div class="container-xl">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <span class="brand-badge"><i class="bi bi-hospital"></i></span>
                    <span class="brand-text">MedDentist <span class="badge bg-emerald-subtle text-emerald-400 ms-1 fw-semibold">Platform</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-area="" asp-page="/Index">
                                <i class="bi bi-speedometer2 me-1"></i> Overview
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Clinics") == true ? "active" : "")" asp-area="" asp-page="/Admin/Clinics/Index">
                                <i class="bi bi-building me-1"></i> Clinics Management
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <span class="system-status-pill d-none d-md-inline-flex align-items-center gap-2">
                            <span class="status-dot online"></span> System Healthy
                        </span>
                        <div class="user-dropdown d-flex align-items-center gap-2 text-white">
                            <div class="avatar-sm">
                                <i class="bi bi-person-circle fs-5"></i>
                            </div>
                            <span class="user-email text-slate-300 small fw-medium d-none d-sm-inline">@User.Identity?.Name</span>
                            <a asp-page="/Account/Logout" class="btn btn-sm btn-outline-danger ms-2" title="Sign Out">
                                <i class="bi bi-box-arrow-right"></i> <span class="d-none d-md-inline">Logout</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl app-container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer mt-auto py-4 border-top">
        <div class="container-xl d-flex flex-wrap justify-content-between align-items-center gap-2 text-muted small">
            <div>
                <strong>MedDentist Multi-Tenant Platform</strong> &copy; 2026. All rights reserved.
            </div>
            <div class="d-flex gap-3">
                <a href="http://app.localhost:8080" target="_blank" class="text-decoration-none text-muted"><i class="bi bi-box-arrow-up-right me-1"></i>Clinic App</a>
                <a href="http://book.localhost:8080" target="_blank" class="text-decoration-none text-muted"><i class="bi bi-calendar-check me-1"></i>Patient Booking</a>
                <a href="http://api.localhost:8080/health/ready" target="_blank" class="text-decoration-none text-muted"><i class="bi bi-heart-pulse me-1"></i>API Health</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
