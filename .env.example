# MedAudit hosted environment template
# Set these values in the hosting provider, never commit real secrets.

ASPNETCORE_ENVIRONMENT=Production
POSTGRES_DB=meddentist
POSTGRES_USER=meddentist
POSTGRES_PASSWORD=CHANGE_ME
JWT_ISSUER=MedDentist
JWT_AUDIENCE=MedDentist.Client
JWT_SIGNING_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
MONITOR_ALERT_EMAIL=

# External URLs used in confirmation, welcome and recovery emails.
PUBLIC_APP_URL=https://medaudit.online
CLINIC_APP_URL=https://app.medaudit.online

# Generate 32 random bytes as hexadecimal; use the same value for API and admin.
RATE_LIMIT_KEY_SECRET=replace-with-64-random-hex-characters

# Database isolation: generate two different random passwords (32+ characters).
DATABASE_APP_PASSWORD=
DATABASE_WORKER_PASSWORD=
